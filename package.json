{
  "name": "firecost",
  "private": true,
  "version": "0.0.0",
  "description": "Catch Firestore queries that will blow up your Firebase bill — before they ship.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktul15/firecost.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.0.0",
    "pnpm": "^9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@firecost/config": "workspace:*",
    "@vitest/coverage-v8": "^2.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
